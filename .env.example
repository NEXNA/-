# 复制为 .env 后填写。这个文件不要提交到任何仓库，也不要发到群里。

# DeepSeek 开放平台的 API Key：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# NapCat 里「HTTP 服务器」配置的 Token，两边必须一致
ONEBOT_ACCESS_TOKEN=change-me-onebot-token

# NapCat 上报到本机 bot 时携带的令牌，自己生成一串随机字符
# 可以用 PowerShell 生成： -join ((48..57)+(97..122) | Get-Random -Count 32 | % {[char]$_})
WEBHOOK_TOKEN=change-me-webhook-token

# 可选：控制台扫码登录用的 NapCat WebUI 地址和 token
# 不填就读 config.toml 的 [napcat] 或 data/desktop.json
NAPCAT_WEBUI_URL=http://127.0.0.1:6099
NAPCAT_WEBUI_TOKEN=change-me-napcat-webui-token
